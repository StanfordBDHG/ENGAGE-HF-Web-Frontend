{
  "name": "engagehfwebfrontend",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Schmiedmayer Lab ENGAGE-HF Web Frontend",
  "keywords": [
    "Stanford"
  ],
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SchmiedmayerLab/ENGAGE-HF-Web-Frontend"
  },
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint --output-file eslint_report.json --format json .",
    "test": "vitest run --coverage",
    "prepush": "npm run lint:fix && tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "test:e2e": "firebase emulators:exec --project demo-engage-hf -c ./ENGAGE-HF-Firebase/firebase.json --only auth,firestore,functions,storage 'npm run test:e2e:seed && playwright test'",
    "test:e2e:seed": "curl -fsS -X PUT localhost:4400/functions/disableBackgroundTriggers 1>/dev/null && curl -fsS --location \"http://localhost:5001/demo-engage-hf/us-central1/defaultSeed\" --header \"Content-Type: application/json\" --data \"{\\\"staticData\\\": {}}\" 1>/dev/null && curl -fsS -X PUT localhost:4400/functions/enableBackgroundTriggers 1>/dev/null"
  },
  "dependencies": {
    "@schmiedmayerlab/engagehf-models": "^0.14.0",
    "@schmiedmayerlab/grove-design-system": "^0.1.1",
    "@t3-oss/env-core": "^0.13.10",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.166.3",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.1.0",
    "es-toolkit": "^1.45.1",
    "firebase": "^12.10.0",
    "lucide-react": "^0.577.0",
    "next-intl": "^4",
    "react": "^19",
    "react-dom": "^19",
    "use-debounce": "^10.1.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@schmiedmayerlab/grove-configurations": "^0.1.1",
    "@storybook/react-vite": "^10.2.16",
    "@tailwindcss/postcss": "^4.2.1",
    "@tanstack/router-plugin": "^1.166.3",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10",
    "eslint": "^10.8.0",
    "firebase-tools": "^14.24.1",
    "jsdom": "^28.1.0",
    "postcss": "^8",
    "prettier": "^3",
    "storybook": "^10.2.16",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vite": "^7.3.1",
    "vitest": "^5.0.0"
  }
}
